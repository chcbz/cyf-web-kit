{
  "name": "cyf-web-kit",
  "version": "1.0.0",
  "type": "module",
  "description": "A Vue.js project",
  "author": "chc <c@e2tt.com>",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "lint": "eslint src",
    "lint:game": "eslint \"src/game/**/*.ts\" \"tests/game/**/*.ts\"",
    "test": "node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "test:watch": "node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json --watch",
    "test:run": "node --import tsx ./node_modules/mocha/bin/mocha.js --config .mocharc.json",
    "test:game": "node --import tsx ./node_modules/mocha/bin/mocha.js --no-config --extension ts \"tests/game/**/*.test.ts\"",
    "typecheck:game": "tsc --project tsconfig.game.json",
    "test:juyiting:ui-smoke": "node tests/juyiting-public-beta-ui-smoke.mjs",
    "test:juyiting:agent-smoke": "node tests/juyiting-agent-online-smoke.mjs",
    "test:juyiting:preflight": "node tests/juyiting-public-beta-preflight.mjs",
    "generate:juyiting-prop-sort-spec": "node scripts/juyiting/generate-prop-sort-spec.mjs",
    "verify:juyiting-prop-sort-spec": "node scripts/juyiting/verify-prop-sort-spec.mjs",
    "validate:juyiting-map": "node --import tsx scripts/juyiting/validate-map.mjs",
    "preview:juyiting-map": "node --import tsx scripts/juyiting/render-map-preview.mjs",
    "validate:juyiting-sprites": "node --import tsx scripts/juyiting/validate-sprites.mjs",
    "inventory:juyiting-map": "node scripts/juyiting/inventory-juyiting-map.mjs",
    "hash:juyiting-sources": "node --import tsx scripts/juyiting/hash-juyiting-sources.mjs",
    "preview:juyiting-occlusion-layers": "node scripts/juyiting/render-occlusion-layers.mjs",
    "asset:juyiting-report": "node --import tsx scripts/juyiting/asset-report-juyiting.mjs",
    "test:juyiting-occlusion-baseline": "node --import tsx ./node_modules/mocha/bin/mocha.js --no-config --require ./tests/setup.js --reporter spec tests/juyiting-occlusion-baseline.test.js",
    "test:juyiting-occlusion-prop-sort": "node --import tsx ./node_modules/mocha/bin/mocha.js --no-config --require ./tests/setup.js --reporter spec tests/juyiting-occlusion-prop-sort.test.js",
    "generate:mask-ledger": "node scripts/juyiting/generate-mask-migration-ledger.mjs",
    "validate:mask-ledger": "node scripts/juyiting/validate-mask-migration-ledger.mjs",
    "test:mask-ledger": "node --import tsx ./node_modules/mocha/bin/mocha.js --no-config --require ./tests/setup.js --reporter spec tests/juyiting-occlusion-mask-migration.test.js --timeout 30000",
    "render:mask-contact-sheet": "node scripts/juyiting/render-mask-contact-sheet.mjs"
  },
  "dependencies": {
    "@varlet/ui": "^3.10.9",
    "@vueuse/core": "^13.5.0",
    "clipboard": "^2.0.1",
    "consola": "^3.4.2",
    "dayjs": "^1.11.10",
    "dompurify": "^3.2.6",
    "marked": "^16.0.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.16",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.3.0",
    "melonjs": "^15.7.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.24.1",
    "@babel/register": "^7.28.3",
    "@rollup/plugin-yaml": "^4.1.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/vue": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@varlet/import-resolver": "^3.11.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/compiler-sfc": "^3.5.16",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "babel-plugin-transform-vue-jsx": "^3.5.0",
    "chai": "^6.0.1",
    "eslint": "^9.3.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^26.1.0",
    "less": "^3.8.1",
    "lodash": "^4.17.23",
    "mocha": "^11.7.2",
    "mochawesome": "^7.1.3",
    "pngjs": "^5.0.0",
    "postcss-import": "^16.1.0",
    "postcss-url": "^10.1.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.46.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.13"
    },
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    },
    "mochawesome": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">= 18.19.0",
    "npm": ">= 9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
