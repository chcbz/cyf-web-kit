# Local-only test area. Tenant isolation is configured by the backend, not the frontend.
VITE_OAUTH_CLIENT_ID=cyf-local
# Use the local authorization server; do not inherit production endpoints.
VITE_OAUTH_BASE_URL=http://127.0.0.1:10019
VITE_API_BASE_URL=http://127.0.0.1:10019
VITE_API_PROXY_TARGET=http://127.0.0.1:10019
VITE_OAUTH_PROXY_TARGET=http://127.0.0.1:10019
