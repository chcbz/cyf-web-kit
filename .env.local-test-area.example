# Local code connects to the shared business TEST area; it does not create a second database.
VITE_DEFAULT_TENANT_ID=1
VITE_TENANT_SELECTION_MODE=fixed
VITE_OAUTH_CLIENT_ID=cyf-local
# Replace with the signed JWT iss claim from the actual registered issuer; do not guess from the API address.
VITE_OAUTH_ISSUER=https://auth.example.invalid
VITE_API_BASE_URL=http://127.0.0.1:10019
